#!/bin/sh

## variables
PAUSE_TIME=1
LOGO_DIR="/usr/share/assets/sinix/logos/ascii-2.txt"

HEADER="*(((((SINIX)))))*-"
GITHUB_SITE="https://github.com/theskepticpillow/sinix"
QUOTE="'Welcome to my operating system, i hope you love it <3'"
QUOTE_AUTHOR="-tspillow! (theskepticpillow)"
CONTRIB_HEADERS_START="Project contributors >>"
CONTRIBUTORS="
PROJECT LEADER: theskepticpillow
Name Idea: damarts_too_smarts
Contributors: solstice, damarts_too_smarts


Thanks for contributing! Enjoy Sinix Linux!
----------------------------------------------------"

## execution
cat "$LOGO_DIR"
echo "$HEADER"
echo "$GITHUB_SITE"
sleep "$PAUSE_TIME"

echo "$QUOTE"
echo "$QUOTE_AUTHOR"
sleep "$PAUSE_TIME"

echo "$CONTRIB_HEADERS_START"
sleep "$PAUSE_TIME"

echo "$CONTRIBUTORS"
sleep 3
